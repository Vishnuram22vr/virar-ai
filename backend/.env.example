# Application Settings
PROJECT_NAME="Virar AI"
APP_ENV="development"
DEBUG=true
PORT=8000

# SQLite Async URL for local development
DATABASE_URL="sqlite+aiosqlite:///./virar_ai.db"

# Development Governance Credentials (Placeholders)
DEV_AUTH_MODE=true
DEV_ADMIN_KEY="virar-dev-key-change-in-prod"
DEV_USER_ID="admin-developer"

# Execution Controls
MAX_STEPS_PER_RUN=15
RUN_TIMEOUT_SECONDS=60
MAX_RETRIES=3

# LLM Provider Configuration
LLM_PROVIDER="deterministic"
LLM_API_KEY=""
LLM_MODEL="virar-deterministic-v1"
